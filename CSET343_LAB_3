        "# Healthcare-specific cleaning"
      ],
      "metadata": {
        "id": "tPLgFhvZFkii"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "pima_clean = pima.copy()\n",
        "\n",
        "# Zero is not clinically meaningful for these measurements.\n",
        "clinical_columns = [\n",
        "    \"Glucose\",\n",
        "    \"BloodPressure\",\n",
        "    \"SkinThickness\",\n",
        "    \"Insulin\",\n",
        "    \"BMI\"\n",
        "]\n",
        "\n",
        "# Replace invalid zeros with NaN\n",
        "pima_clean[clinical_columns] = (\n",
        "    pima_clean[clinical_columns].replace(0, np.nan)\n",
        ")\n",
        "\n",
        "print(\"\\nMissing values after replacing implausible zeros:\")\n",
        "display(pima_clean.isnull().sum())\n",
        "\n",
        "# Median imputation\n",
        "for column in clinical_columns:\n",
        "    pima_clean[column] = (\n",
        "        pima_clean[column]\n",
        "        .fillna(pima_clean[column].median())\n",
        "    )\n",
        "\n",
        "print(\"\\nMissing values after median imputation:\")\n",
        "display(pima_clean.isnull().sum())"
      ],
