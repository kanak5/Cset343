      "source": [
        "# 8. ENCODING + SCALING"
      ],
      "metadata": {
        "id": "BKn8PNL0GE4h"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "model_df = pd.get_dummies(\n",
        "    pima_fe,\n",
        "    columns=[\n",
        "        \"BMI_Category\",\n",
        "        \"Age_Group\"\n",
        "    ],\n",
        "    drop_first=True\n",
        ")\n",
        "\n",
        "X = model_df.drop(\n",
        "    \"Outcome\",\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "y = model_df[\"Outcome\"]\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "print(\n",
        "    \"Scaled feature matrix shape:\",\n",
        "    X_scaled.shape\n",
        ")"
