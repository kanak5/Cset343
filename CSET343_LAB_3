        "stop_words = set(\n",
        "    stopwords.words(\"english\")\n",
        ")\n",
        "\n",
        "lemmatizer = WordNetLemmatizer()\n",
        "\n",
        "\n",
        "def clean_medical_text(text):\n",
        "\n",
        "    if pd.isna(text):\n",
        "        return \"\"\n",
        "\n",
        "    text = str(text).lower()\n",
        "\n",
        "    # Remove special characters and numbers\n",
        "    text = re.sub(\n",
        "        r\"[^a-zA-Z\\s]\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Remove extra spaces\n",
        "    text = re.sub(\n",
        "        r\"\\s+\",\n",
        "        \" \",\n",
        "        text\n",
        "    ).strip()\n",
        "\n",
        "    # Tokenization\n",
        "    tokens = text.split()\n",
        "\n",
        "    # Stopword removal\n",
        "    tokens = [\n",
        "        word\n",
        "        for word in tokens\n",
        "        if word not in stop_words\n",
        "    ]\n",
        "\n",
        "    # Lemmatization\n",
        "    tokens = [\n",
        "        lemmatizer.lemmatize(word)\n",
        "        for word in tokens\n",
        "    ]\n",
        "\n",
        "    return \" \".join(tokens)\n",
        "\n",
        "\n",
        "mtsamples[\"processed_text\"] = (\n",
        "    mtsamples[\"clean_text\"]\n",
        "    .apply(clean_medical_text)\n",
        ")\n",
        "\n",
        "print(\"\\nText preprocessing completed.\")\n",
        "\n",
        "display(\n",
        "    mtsamples[\n",
        "        [\n",
        "            \"clean_text\",\n",
        "            \"processed_text\"\n",
        "        ]\n",
        "    ].head()\n",
        ")"
