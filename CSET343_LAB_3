        "def augment_image(img):\n",
        "\n",
        "    augmented = []\n",
        "\n",
        "    # Horizontal flip\n",
        "    augmented.append(\n",
        "        ImageOps.mirror(img)\n",
        "    )\n",
        "\n",
        "    # Rotation\n",
        "    augmented.append(\n",
        "        img.rotate(\n",
        "            10,\n",
        "            fillcolor=0\n",
        "        )\n",
        "    )\n",
        "\n",
        "    # Contrast enhancement\n",
        "    augmented.append(\n",
        "        ImageOps.autocontrast(img)\n",
        "    )\n",
        "\n",
        "    # Slight blur\n",
        "    augmented.append(\n",
        "        img.filter(\n",
        "            ImageFilter.GaussianBlur(\n",
        "                radius=1\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "\n",
        "    return augmented\n",
        "\n",
        "\n",
        "original_image = Image.open(\n",
        "    sample_path\n",
        ").convert(\"L\")\n",
        "\n",
        "augmented_images = augment_image(\n",
        "    original_image\n",
        ")\n",
        "\n",
        "plt.figure(\n",
        "    figsize=(12,8)\n",
        ")\n",
        "\n",
        "display_images = [\n",
        "    original_image\n",
        "] + augmented_images\n",
        "\n",
        "for i, img in enumerate(\n",
