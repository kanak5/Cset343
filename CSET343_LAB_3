      "source": [
        "def remove_phi(text):\n",
        "\n",
        "    if pd.isna(text):\n",
        "        return \"\"\n",
        "\n",
        "    text = str(text)\n",
        "\n",
        "    # Email\n",
        "    text = re.sub(\n",
        "        r'\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b',\n",
        "        '[EMAIL]',\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Phone number\n",
        "    text = re.sub(\n",
        "        r'\\b(?:\\+?\\d[\\d\\-\\s()]{7,}\\d)\\b',\n",
        "        '[PHONE]',\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Dates\n",
        "    text = re.sub(\n",
        "        r'\\b\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}\\b',\n",
        "        '[DATE]',\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Common patient ID / MRN patterns\n",
        "    text = re.sub(\n",
        "        r'\\b(?:MRN|PATIENT\\s*ID|PATIENTID)\\s*[:#-]?\\s*\\w+\\b',\n",
        "        '[PATIENT_ID]',\n",
        "        text,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    return text\n",
        "\n",
        "\n",
        "mtsamples[\"clean_text\"] = (\n",
        "    mtsamples[text_column]\n",
        "    .apply(remove_phi)\n",
        ")\n",
        "\n",
        "print(\"\\nPHI masking completed.\")\n",
        "\n",
        "display(\n",
        "    mtsamples[\n",
        "        [text_column, \"clean_text\"]\n",
        "    ].head()\n",
        ")"
      ],
