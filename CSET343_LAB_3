      "cell_type": "code",
      "source": [
        "pima_anova = pima_clean.copy()\n",
        "\n",
        "pima_anova[\"GlucoseGroup\"] = pd.qcut(\n",
        "    pima_anova[\"Glucose\"],\n",
        "    q=3,\n",
        "    labels=[\n",
        "        \"Low Glucose\",\n",
        "        \"Medium Glucose\",\n",
        "        \"High Glucose\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "anova_groups = []\n",
        "\n",
        "for name, group in pima_anova.groupby(\n",
        "    \"GlucoseGroup\",\n",
        "    observed=False\n",
        "):\n",
        "    print(\n",
        "        name,\n",
        "        \"count =\",\n",
        "        len(group),\n",
        "        \"mean BMI =\",\n",
        "        group[\"BMI\"].mean()\n",
        "    )\n",
        "\n",
        "    anova_groups.append(\n",
        "        group[\"BMI\"].values\n",
        "    )\n",
        "\n",
        "f_statistic, anova_p = stats.f_oneway(\n",
        "    *anova_groups\n",
        ")\n",
        "\n",
        "print(\"\\nF-statistic:\", f_statistic)\n",
        "print(\"p-value:\", anova_p)\n",
        "\n",
        "if anova_p < 0.05:\n",
        "    print(\n",
        "        \"Conclusion: At least one glucose group \"\n",
        "        \"has significantly different BMI.\"\n",
        "    )\n",
        "else:\n",
        "    print(\n",
        "        \"Conclusion: No statistically significant \"\n",
        "        \"difference in BMI among glucose groups.\"\n",
        "    )"
