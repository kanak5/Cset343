        "    X.shape[1]\n",
        ")\n",
        "\n",
        "selector = SelectKBest(\n",
        "    score_func=f_classif,\n",
        "    k=k_features\n",
        ")\n",
        "\n",
        "X_selected = selector.fit_transform(\n",
        "    X,\n",
        "    y\n",
        ")\n",
        "\n",
        "selected_features = (\n",
        "    X.columns[\n",
        "        selector.get_support()\n",
        "    ]\n",
        ")\n",
        "\n",
