    {
      "cell_type": "code",
      "source": [
        "if \"medical_specialty\" in mtsamples.columns:\n",
        "\n",
        "    y_text = (\n",
        "        mtsamples[\"medical_specialty\"]\n",
        "        .fillna(\"Unknown\")\n",
        "    )\n",
        "\n",
        "    # Keep classes having at least 2 samples\n",
        "    class_counts = (\n",
        "        y_text.value_counts()\n",
        "    )\n",
        "\n",
        "    valid_classes = (\n",
        "        class_counts[\n",
        "            class_counts >= 2\n",
        "        ].index\n",
        "    )\n",
        "\n",
        "    valid_mask = (\n",
        "        y_text.isin(valid_classes)\n",
        "    )\n",
        "\n",
        "    X_text_valid = X_text[\n",
        "        valid_mask.values\n",
        "    ]\n",
        "\n",
        "    y_text_valid = y_text[\n",
        "        valid_mask\n",
        "    ]\n",
        "\n",
        "    if len(y_text_valid) > 1:\n",
        "\n",
        "        k_text = min(\n",
        "            500,\n",
        "            X_text_valid.shape[1]\n",
        "        )\n",
        "\n",
        "        selector_text = SelectKBest(\n",
        "            score_func=f_classif,\n",
        "            k=k_text\n",
        "        )\n",
        "\n",
        "        X_text_selected = (\n",
        "            selector_text.fit_transform(\n",
        "                X_text_valid,\n",
