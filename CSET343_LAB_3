        "# 4. HYPOTHESIS TEST"
      ],
      "metadata": {
        "id": "nCN1VzAgFwrd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "group_no_diabetes = (\n",
        "    pima_clean[\n",
        "        pima_clean[\"Outcome\"] == 0\n",
        "    ][\"Glucose\"]\n",
        ")\n",
        "\n",
        "group_diabetes = (\n",
        "    pima_clean[\n",
        "        pima_clean[\"Outcome\"] == 1\n",
        "    ][\"Glucose\"]\n",
        ")\n",
        "\n",
        "t_statistic, p_value = stats.ttest_ind(\n",
        "    group_no_diabetes,\n",
        "    group_diabetes,\n",
        "    equal_var=False\n",
        ")\n",
        "\n",
        "print(\"t-statistic:\", t_statistic)\n",
        "print(\"p-value:\", p_value)\n",
        "\n",
        "alpha = 0.05\n",
        "\n",
        "if p_value < alpha:\n",
        "    print(\n",
        "        \"Conclusion: Reject H0. \"\n",
        "        \"There is a statistically significant \"\n",
        "        \"difference in glucose levels.\"\n",
        "    )\n",
        "else:\n",
        "    print(\n",
        "        \"Conclusion: Fail to reject H0.\"\n",
        "    )"
      ],
