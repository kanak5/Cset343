    {
      "cell_type": "code",
      "source": [
        "pima_chi = pima_clean.copy()\n",
        "\n",
        "pima_chi[\"AgeGroup\"] = pd.cut(\n",
        "    pima_chi[\"Age\"],\n",
        "    bins=[20, 30, 40, 50, 100],\n",
        "    labels=[\n",
        "        \"21-30\",\n",
        "        \"31-40\",\n",
        "        \"41-50\",\n",
        "        \"51+\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "contingency_table = pd.crosstab(\n",
        "    pima_chi[\"AgeGroup\"],\n",
        "    pima_chi[\"Outcome\"]\n",
        ")\n",
        "\n",
        "print(\"\\nContingency Table:\")\n",
        "display(contingency_table)\n",
        "\n",
        "chi2, chi_p, dof, expected = (\n",
        "    stats.chi2_contingency(\n",
        "        contingency_table\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"Chi-square statistic:\", chi2)\n",
        "print(\"p-value:\", chi_p)\n",
        "print(\"Degrees of freedom:\", dof)\n",
        "\n",
        "if chi_p < 0.05:\n",
        "    print(\n",
        "        \"Conclusion: Significant association \"\n",
        "        \"between Age Group and Diabetes Outcome.\"\n",
        "    )\n",
        "else:\n",
        "    print(\n",
        "        \"Conclusion: No significant association \"\n",
        "        \"between Age Group and Diabetes Outcome.\"\n",
        "    )"
