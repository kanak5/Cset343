        "    IQR = Q3 - Q1\n",
        "    lower = Q1 - 1.5 * IQR\n",
        "    upper = Q3 + 1.5 * IQR\n",
        "    df[feat] = np.clip(df[feat], lower, upper)\n",
        "\n",
        "print(\"\\nOutliers capped using IQR method (Winsorization).\")"
